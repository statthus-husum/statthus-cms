# Caddy holt automatisch ein Let's-Encrypt-Zertifikat für CMS_DOMAIN —
# vorausgesetzt, die Domain löst öffentlich auf den Server auf.
#
# Zum Testen ohne öffentliches DNS:
#   1. Auskommentiertes `tls internal` unten aktivieren (selbstsigniertes Cert)
#   2. Lokal /etc/hosts: 178.105.26.106 schreibe.statthus-husum.de
#   3. docker compose restart caddy
# Sobald DNS live ist: `tls internal` wieder auskommentieren, Caddy neu starten.

{$CMS_DOMAIN} {
    # tls internal             # ← TEST-MODUS: selbstsigniertes Cert ohne DNS
    encode gzip zstd

    header {
        # Sicherheit
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Admin-Tool — kein Suchmaschinen-Index
        X-Robots-Tag "noindex, nofollow"
        # Frame-Embedding für Tinas Visual-Edit-Mode möglicherweise später nötig.
        # X-Frame-Options bewusst NICHT auf DENY gesetzt — Tina iframe-Preview braucht's.
    }

    # Cache-Strategie für Tinas Admin-SPA:
    #   - index.html + /admin-tweaks.js sind NICHT gehasht. Werden sie
    #     gecacht, zeigt index.html nach einem Deploy auf veraltete
    #     gehashte Bundles → eingefrorener Menübaum. Darum no-store.
    #   - /admin/assets/index-<hash>.js ändern den Namen pro Build,
    #     dürfen also unbegrenzt (immutable) gecacht werden.
    @admin_nocache {
        path /admin /admin/ /admin/index.html /admin-tweaks.js
    }
    header @admin_nocache Cache-Control "no-store"

    @admin_assets {
        path /admin/assets/*
    }
    header @admin_assets Cache-Control "public, max-age=31536000, immutable"

    # Freigabe-App (Approval-Dashboard) auf /freigabe/* — Pfad wird gestripped,
    # die App sieht nur "/" und "/merge".
    handle_path /freigabe* {
        reverse_proxy freigabe:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Alles andere geht an Tina (inkl. /admin/...)
    reverse_proxy tina:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Media-Auslieferung: proxied den öffentlichen Hetzner-S3-Media-Bucket als
# first-party Domain (bilder.statthus-husum.de). Bewusst KEIN externes CDN —
# Besucher-IPs bleiben bei uns (gleiche Logik wie der Honeypot-statt-
# reCAPTCHA-Entscheid). Der Bucket erlaubt anonym nur GetObject (Policy in
# statthus-infra), Listing ist zu — die Galerie liest ihre Bildliste aus
# uploads/<Ordner>/manifest.json.
{$MEDIA_DOMAIN} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        # Die Website (statthus-husum.de) lädt manifest.json per fetch()
        # cross-origin; Bilder in <img> bräuchten kein CORS. Öffentliche,
        # unkritische Inhalte → pauschal erlauben.
        Access-Control-Allow-Origin "*"
    }

    # Manifeste ändern sich bei jedem Upload → nicht cachen (ETag-
    # Revalidierung reicht). Bilder: Dateinamen sind stabil, Inhalte
    # können aber ersetzt werden → 1 Tag Browser-Cache als Mittelweg.
    # Hetzner OS liefert selbst kein Cache-Control, daher kein Konflikt
    # mit Upstream-Headern.
    @manifest path */manifest.json
    header @manifest Cache-Control "no-cache"
    @images not path */manifest.json
    header @images Cache-Control "public, max-age=86400"

    # Nur GET/HEAD nach draußen — alles Schreibende geht ausschließlich
    # authentifiziert über die Tina-API (schreibe.statthus-husum.de).
    # Pfad-Style-Rewrite: bilder.../uploads/x.jpg → S3 /<bucket>/uploads/x.jpg
    @readonly method GET HEAD
    handle @readonly {
        rewrite * /{$MEDIA_S3_BUCKET}{uri}
        reverse_proxy https://{$S3_ENDPOINT} {
            header_up Host {$S3_ENDPOINT}
        }
    }
    handle {
        respond "Method Not Allowed" 405
    }

    log {
        output stdout
        format console
        level INFO
    }
}
