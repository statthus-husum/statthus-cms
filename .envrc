use flake
source_env_if_exists .envrc.local
# Contract: all app secrets (see .env.example) come from .envrc.local (OpenBao).
# Key link to the website = the GitHub PAT the CMS commits content with:
[ -n "$GITHUB_PERSONAL_ACCESS_TOKEN" ] || log_status "cms secrets unset — create .envrc.local (see .env.example)"
