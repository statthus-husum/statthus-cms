# GitHub-Credentials — Tina committet Content in dieses Repo
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=statthus-husum
GITHUB_REPO=statthus-website
GITHUB_BRANCH=main

# NextAuth.js JWT Secret (mind. 32 Zeichen, zufällig)
# Generieren: openssl rand -base64 32
NEXTAUTH_SECRET=changeme-mit-openssl-rand

# MongoDB als Datalayer-Index
# Im Docker-Stack: mongodb://tina:tina@mongo:27017/tinacms?authSource=admin
MONGODB_URI=
MONGODB_DBNAME=tinacms
MONGODB_COLLECTION=tinacms

# In Produktion immer false (oder nicht setzen). Lokal mit "pnpm dev" wird's auf true gesetzt.
TINA_PUBLIC_IS_LOCAL=false
