# Kopiere zu .env. Auf dem Server liegt diese Datei in /opt/cms/.env.
# Cloud-init schreibt nur CMS_DOMAIN — Rest muss per SSH gesetzt werden.

# === Domain ===
CMS_DOMAIN=schreibe.statthus-husum.de

# === Daten-Verzeichnis ===
# Auf der Hetzner-VM: /opt/cms-data (Hetzner-Volume).
# Lokal weglassen — Default ist ./data.
CMS_DATA_DIR=/opt/cms-data

# === GitHub-Provider ===
# Tina committet hier rein. PAT mit "Contents: Read & Write" auf statthus-website.
# Anlegen: https://github.com/settings/personal-access-tokens/new
# Scope (fine-grained): nur statthus-husum/statthus-website wählen.
GITHUB_OWNER=statthus-husum
GITHUB_REPO=statthus-website
# WICHTIG: Tina committet hier rein. "staging" → Editorial Workflow
# (Edits müssen über die Freigabe-App auf main gemerged werden).
# "main" → Edits gehen direkt live (kein Review).
GITHUB_BRANCH=staging
PROD_BRANCH=main
GITHUB_PERSONAL_ACCESS_TOKEN=

# === Freigabe-App (Approval-Dashboard) ===
# Login-Daten für https://schreibe.statthus-husum.de/freigabe/
# Nur Admins, die staging→main mergen dürfen.
FREIGABE_USER=admin
FREIGABE_PASS=

# === Auth.js ===
# JWT-Secret. 32 Byte Random — generieren mit:  openssl rand -base64 32
NEXTAUTH_SECRET=

# === MongoDB ===
# Initiale Root-Credentials. Bitte beim ersten Start setzen — werden vom mongo-Container
# beim Erst-Init übernommen. Spätere Änderung erfordert User-Update via mongosh.
MONGO_USER=tina
MONGO_PASS=

# Datenbank/Collection-Namen (Defaults sind ok)
MONGODB_DBNAME=tinacms
MONGODB_COLLECTION=tinacms

# === Backup (Tina-User-Store -> Hetzner Object Storage) ===
# WICHTIG: Editor-Accounts liegen NUR in MongoDB, nie in Git. Ohne dieses
# Backup löscht ein Mongo-Wipe / `down -v` / VM-Neuaufbau alle Logins.
# Bucket + Endpoint kommen aus statthus-infra: `tofu output backup_env_hint`.
# S3_ACCESS_KEY/S3_SECRET_KEY = dieselben wie in der infra-terraform.tfvars
# (einmalig in der Hetzner Console erzeugt).
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=statthus-cms-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Sekunden zwischen Backups (Default 21600 = 6h) / Aufbewahrung in Tagen
BACKUP_INTERVAL=21600
BACKUP_RETENTION=30
# Optional, empfohlen: symmetrische Verschlüsselung der Dumps (AES256).
# ACHTUNG: Passphrase separat sichern (Passwortmanager) — ohne sie ist
# KEIN Restore möglich. Leer = unverschlüsselt (Bucket ist privat).
BACKUP_ENC_PASSPHRASE=
