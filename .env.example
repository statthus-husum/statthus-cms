# Kopiere zu .env (auf dem Server in /opt/cms/.env wird das von cloud-init erzeugt)

# Domain unter der das CMS erreichbar ist. Caddy zieht darüber automatisch
# ein Let's-Encrypt-Zertifikat — DNS muss vorher auf den Server zeigen.
CMS_DOMAIN=autor.statthus.de

